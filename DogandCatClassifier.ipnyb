2026-09-22T16:43:23.755155Z","shell.execute_reply.started":"2026-09-22T16:43:23.751106Z","shell.execute_reply":"2026-09-22T16:43:23.754271Z"}},"outputs":[],"execution_count":57},{"cell_type":"code","source":"accuracy = (TP + TN)/(TP + TN + FP + FN)\nprecision = (TP)/(TP + FP)\nrecall = (TP)/(TP + FN)\nF1_Score  = (2*precision*recall)/(precision+recall)\nprint(f'Accuracy : {accuracy * 100}%')\nprint(f'Precision: {precision * 100}%')\nprint(f'recall: {recall * 100}%')\nprint(f'F1-Score: {F1_Score*100}%')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-22T16:43:24.875931Z","iopub.execute_input":"2026-09-22T16:43:24.876516Z","iopub.status.idle":"2026-09-22T16:43:24.882268Z","shell.execute_reply.started":"2026-09-22T16:43:24.876486Z","shell.execute_reply":"2026-09-22T16:43:24.881422Z"}},"outputs":[{"name":"stdout","text":"Accuracy : 98.59943977591037%\nPrecision: 99.07070707070707%\nrecall: 98.11924769907964%\nF1-Score: 98.59268194611982%\n","output_type":"stream"}],"execution_count":58},{"cell_type":"markdown","source":"# Plotting ROC AUC Curve for deciding the threshold value","metadata":{}},{"cell_type":"code","source":"from sklearn.metrics import roc_curve\n\nfpr, tpr, thresholds = roc_curve(true, prob)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-22T16:43:30.902785Z","iopub.execute_input":"2026-09-22T16:43:30.903736Z","iopub.status.idle":"2026-09-22T16:43:30.909739Z","shell.execute_reply.started":"2026-09-22T16:43:30.903704Z","shell.execute_reply":"2026-09-22T16:43:30.908845Z"}},"outputs":[],"execution_count":59},{"cell_type":"markdown","source":"## Understanding TPR VS FPR:\n**TPR -> True Positive Rate also called recall.**  \n**TPR = TP / TP + FN**    \nFPR -> False Positive Rate  \n**FPR  = FP/ FP + TN** ","metadata":{}},{"cell_type":"code","source":"print(f'FPR: {fpr}')\nprint(f'TPR: {tpr}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-22T16:43:32.595333Z","iopub.execute_input":"2026-09-22T1