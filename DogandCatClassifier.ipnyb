ace:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Total params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">5,631,169</span> (21.48 MB)\n</pre>\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"\u001b[1m Trainable params: \u001b[0m\u001b[38;5;34m5,631,169\u001b[0m (21.48 MB)\n","text/html":"<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Trainable params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">5,631,169</span> (21.48 MB)\n</pre>\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"\u001b[1m Non-trainable params: \u001b[0m\u001b[38;5;34m0\u001b[0m (0.00 B)\n","text/html":"<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Non-trainable params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">0</span> (0.00 B)\n</pre>\n"},"metadata":{}}],"execution_count":20},{"cell_type":"code","source":"history_2 = model_2.fit(train_data_flow , validation_data=val_data, epochs = 10)","metadata":{"id":"hzbib6YDpXS4","executionInfo":{"status":"ok","timestamp":1789406574316,"user_tz":-330,"elapsed":12642142,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"outputId":"f0d18c6e-a205-42a7-c156-8a7e301996c9"},"outputs":[],"execution_count":null},{"cell_type":"code","source":"path_model = \"/content/drive/MyDrive/Models/custom_cnn_regularized.keras\"\nmodel_2.save(path_model)","metadata":{"id":"6eOrpRbrpXOw"},"outputs":[],"execution_count":null},{"cell_type":"code","source":"path_history_2 = '/content/drive/MyDrive/Models/custom_cnn_baseline_history.csv'\nhistory_df_2 = pd.DataFrame(history_2.history)\nhistory_df_2.to_csv(\"custom_cnn_baseline_history.csv\", index=False)","metadata":{"id":"XQ-5ryxrpXKP"},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Model 3:\n- As model 2 was worse so i decide to move on to model 3 by doing little bit of hyperparameter tuning.\n## What will change from previous Model_2:\n    -> Use SGD(Stochastic Gradient Descent) as an optimizer with learning rate of 0.01.  \n    -> Use drop out to prevent overfitting.  \n    -> Change in architecture.  \n    -> Using Different Activation function like leaky relu for preventing the Dying ReLu.[Rectified Linear Unit]\n    -> Change in the kernal size from 3 * 3 to 2 * 2;  \n    -> **MaxPooling** → reduces spatial dimensions gradually DURING convolutional feature extraction.  \n    -> **GlobalAveragePooling** → summarizes the FINAL feature maps before classification.  \n    -> Also training the model for more no of epochs with early stopping to prevent the high compute cost.\n\n## Architecture:\n- input = 224,224,3\n- Conv2d = 32 , (2*2),\n- maxPolling2D(2,2),\n- Conv2d = 64 , (2*2)\n- maxPolling2D(2,2),\n- Conv2d = 128 , (2*2)\n- maxPolling2D(2,2),\n- Conv2d =- 256 , (2*2)\n- Flatten()\n- dropout(.20),\n- dense layer (64)\n- dense layer (32)\n- dense layer (16)\n- output layer\n\n> Leaky ReLU is used to reduce the risk of \"dying ReLU\" neurons by allowing a small negative output instead of setting all negative inputs to zero.  \n\n> I will investigate whether smaller 2×2 convolutional kernels can provide sufficient feature extraction while changing the model's computational/representational characteristics.","metadata":{"id":"EVJ5GlCqiz4N"}},{"cell_type":"code","source":"path  = '/content/drive/MyDrive/Datasets/PetImages'","metadata":{"id":"wz42MbC9lUfw","trusted":true,"execution":{"iopub.status.busy":"2026-09-17T06:54:19.464655Z","iopub.execute_input":"2026-09-17T06:54:19.464919Z","iopub.status.idle":"2026-09-17T06:54:19.468451Z","shell.execute_reply.started":"2026-09-17T06:54:19.464896Z","shell.execute_reply":"2026-09-17T06:54:19.467828Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from tensorflow.keras.optimizers import SGD\nfrom tensorflow.keras.layers import LeakyReLU","metadata":{"id":"7tYJSoT_pXGU","executionInfo":{"status":"ok","timestamp":1789582818180,"user_tz":-330,"elapsed":43,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T17:26:01.470837Z","iopub.execute_input":"2026-09-21T17:26:01.471139Z","iopub.status.idle":"2026-09-21T17:26:01.475025Z","shell.execute_reply.started":"2026-09-21T17:26:01.47111Z","shell.execute_reply":"2026-09-21T17:26:01.474218Z"}},"outputs":[],"execution_count":21},{"cell_type":"code","source":"def model_creator(activation_function,dropout_neurons):\n  model = Sequential(\n      [\n        keras.Input(shape = (224,224,3)),\n\n        layers.Conv2D(filters=32,kernel_size=(2,2),activation =  activation_function),\n        layers.MaxPooling2D(pool_size=(2,2)),\n\n        layers.Conv2D(filters=64,kernel_size=(2,2),activation = activation_function),\n        layers.MaxPooling2D(pool_size=(2,2)),\n\n        layers.Conv2D(filters=128,kernel_size=(2,2),activation= activation_function),\n        layers.MaxPooling2D(pool_size=(2,2)),\n\n        layers.Conv2D(filters= 256, kernel_size = (2,2), activation= activation_function),\n\n        # layers.GlobalAveragePooling2D(),\n        layers.Flatten(),\n        layers.Dropout(dropout_neurons),\n\n        layers.Dense(units=64,activation= activation_function),\n        layers.Dense(units = 32, activation = activation_function),\n        layers.Dense(units = 16, activation = activation_function),\n        layers.Dense(units=1,activation='sigmoid')\n      ]\n  )\n  return model","metadata":{"id":"GHrxj3ympXB8","executionInfo":{"status":"ok","timestamp":1789583849355,"user_tz":-330,"elapsed":51,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T06:57:56.894978Z","iopub.execute_input":"2026-09-17T06:57:56.89566Z","iopub.status.idle":"2026-09-17T06:57:56.90155Z","shell.execute_reply.started":"2026-09-17T06:57:56.89559Z","shell.execute_reply":"2026-09-17T06:57:56.900829Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"activation = LeakyReLU(negative_slope = 0.01)\noptimizer = SGD(learning_rate=0.01)","metadata":{"id":"FgfEaufffFQS","executionInfo":{"status":"ok","timestamp":1789583850399,"user_tz":-330,"elapsed":61,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:01:10.736404Z","iopub.execute_input":"2026-09-17T07:01:10.737113Z","iopub.status.idle":"2026-09-17T07:01:10.745212Z","shell.execute_reply.started":"2026-09-17T07:01:10.73708Z","shell.execute_reply":"2026-09-17T07:01:10.744459Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"model_3 = model_creator(activation,0.2)","metadata":{"id":"-p-m4OJ0f2Rq","executionInfo":{"status":"ok","timestamp":1789583851223,"user_tz":-330,"elapsed":84,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:01:11.402082Z","iopub.execute_input":"2026-09-17T07:01:11.402732Z","iopub.status.idle":"2026-09-17T07:01:11.466447Z","shell.execute_reply.started":"2026-09-17T07:01:11.402681Z","shell.execute_reply":"2026-09-17T07:01:11.465866Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"model_3.summary()","metadata":{"id":"Ux8XnkE-eY3C","executionInfo":{"status":"ok","timestamp":1789583852165,"user_tz":-330,"elapsed":117,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"outputId":"5262c6e9-03cf-4677-cb29-942936fadfe0","trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:01:12.60906Z","iopub.execute_input":"2026-09-17T07:01:12.609345Z","iopub.status.idle":"2026-09-17T07:01:12.629759Z","shell.execute_reply.started":"2026-09-17T07:01:12.609322Z","shell.execute_reply":"2026-09-17T07:01:12.629165Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"early_stop = EarlyStopping(monitor='val_loss',\n                           patience=5,\n                           restore_best_weights=True)","metadata":{"id":"reaqDJfLhWTQ","executionInfo":{"status":"ok","timestamp":1789585236556,"user_tz":-330,"elapsed":64,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:01:13.394223Z","iopub.execute_input":"2026-09-17T07:01:13.394986Z","iopub.status.idle":"2026-09-17T07:01:13.398381Z","shell.execute_reply.started":"2026-09-17T07:01:13.394955Z","shell.execute_reply":"2026-09-17T07:01:13.397761Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"kaggle_output_dir = \"/kaggle/working/model/best_model.keras\"","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:01:16.47427Z","iopub.execute_input":"2026-09-17T07:01:16.474775Z","iopub.status.idle":"2026-09-17T07:01:16.478707Z","shell.execute_reply.started":"2026-09-17T07:01:16.474746Z","shell.execute_reply":"2026-09-17T07:01:16.477815Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"checkpoint = ModelCheckpoint(\n    kaggle_output_dir,\n    monitor=\"val_loss\",\n    save_best_only=True,\n    mode=\"min\",\n    verbose=1\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:01:16.88386Z","iopub.execute_input":"2026-09-17T07:01:16.884415Z","iopub.status.idle":"2026-09-17T07:01:16.888135Z","shell.execute_reply.started":"2026-09-17T07:01:16.884387Z","shell.execute_reply":"2026-09-17T07:01:16.887312Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"model_3.compile(optimizer = optimizer,\n                loss = ['binary_crossentropy'],\n                metrics=['accuracy'])","metadata":{"id":"0I8QeTbQgAXb","executionInfo":{"status":"ok","timestamp":1789585237259,"user_tz":-330,"elapsed":62,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:01:17.371006Z","iopub.execute_input":"2026-09-17T07:01:17.371613Z","iopub.status.idle":"2026-09-17T07:01:17.378532Z","shell.execute_reply.started":"2026-09-17T07:01:17.371582Z","shell.execute_reply":"2026-09-17T07:01:17.377712Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"history_3 = model_3.fit(train_data_flow,\n                        validation_data=val_data,\n                        epochs = 50,\n                        verbose = 'auto',\n                        callbacks = [checkpoint,early_stop]\n                      )","metadata":{"id":"wCq4-_UIg_2H","executionInfo":{"status":"error","timestamp":1789586781156,"user_tz":-330,"elapsed":1542912,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"outputId":"0c2bb387-4703-4244-c28f-b67f0dbcba62","trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:01:25.857157Z","iopub.execute_input":"2026-09-17T07:01:25.857809Z","iopub.status.idle":"2026-09-17T07:25:18.940249Z","shell.execute_reply.started":"2026-09-17T07:01:25.857778Z","shell.execute_reply":"2026-09-17T07:25:18.939392Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Saving The model 3","metadata":{"id":"hdaXoUcSjp6j"}},{"cell_type":"code","source":"import os\n\nsave_dir = \"/kaggle/working/saved_models\"\nos.makedirs(save_dir, exist_ok=True)\n\nprint(save_dir)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:29:58.102022Z","iopub.execute_input":"2026-09-17T07:29:58.102305Z","iopub.status.idle":"2026-09-17T07:29:58.106898Z","shell.execute_reply.started":"2026-09-17T07:29:58.102283Z","shell.execute_reply":"2026-09-17T07:29:58.106035Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"path_model_3 = save_dir + \"/custom_cnn_model_3.keras\"\nmodel_3.save(path_model_3)","metadata":{"id":"TfMq5l8tjcG-","trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:33:59.173389Z","iopub.execute_input":"2026-09-17T07:33:59.174171Z","iopub.status.idle":"2026-09-17T07:33:59.391004Z","shell.execute_reply.started":"2026-09-17T07:33:59.174143Z","shell.execute_reply":"2026-09-17T07:33:59.39038Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"history_3_path = save_dir + \"/custom_cnn3_history.csv\"\nhistory_df_3 = pd.DataFrame(history_3.history)\nhistory_df_3.to_csv(\"custom_cnn3_history.csv\", index=False)","metadata":{"id":"HcJjcRJ7kbfw","trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:34:36.894443Z","iopub.execute_input":"2026-09-17T07:34:36.894724Z","iopub.status.idle":"2026-09-17T07:34:36.910946Z","shell.execute_reply.started":"2026-09-17T07:34:36.894699Z","shell.execute_reply":"2026-09-17T07:34:36.910132Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Plotting the graphs for model_3","metadata":{}},{"cell_type":"code","source":"fig, ax = plt.subplots(1, 2, figsize=(12, 5))\n\n# Accuracy\nax[0].plot(history_3.history['accuracy'], label='Training Accuracy')\nax[0].plot(history_3.history['val_accuracy'], label='Validation Accuracy')\nax[0].set_title('Model Accuracy')\nax[0].set_xlabel('Epoch')\nax[0].set_ylabel('Accuracy')\nax[0].grid()\nax[0].legend()\n\n# Loss\nax[1].plot(history_3.history['loss'], label='Training Loss')\nax[1].plot(history_3.history['val_loss'], label='Validation Loss')\nax[1].set_title('Model Loss')\nax[1].set_xlabel('Epoch')\nax[1].set_ylabel('Loss')\nax[1].grid()\nax[1].legend()\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:41:55.869867Z","iopub.execute_input":"2026-09-17T07:41:55.87044Z","iopub.status.idle":"2026-09-17T07:41:56.148887Z","shell.execute_reply.started":"2026-09-17T07:41:55.870409Z","shell.execute_reply":"2026-09-17T07:41:56.148044Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Conclusion : \n- There is a slight overfitting starting from epoch 12-14 between accuracy and val_accuracy\n- From epoch 10-11\n- But this model shows a very significant improvement from baseline and 2nd model.","metadata":{}},{"cell_type":"markdown","source":"# Evaluating using Classification report","metadata":{}},{"cell_type":"code","source":"val_report = i_d_g.flow_from_directory(\n    path_kaggle,\n    target_size=(224, 224),\n    batch_size=64,\n    class_mode='binary',\n    subset='validation',\n    shuffle=False\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:45:50.047833Z","iopub.execute_input":"2026-09-17T07:45:50.048543Z","iopub.status.idle":"2026-09-17T07:45:50.135235Z","shell.execute_reply.started":"2026-09-17T07:45:50.048515Z","shell.execute_reply":"2026-09-17T07:45:50.134682Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import numpy as np\n\npred_prob = model_3.predict(val_report)\n\npred = (pred_prob > 0.5).astype(int).ravel()\n\ny_true = val_report.classes","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:46:09.319001Z","iopub.execute_input":"2026-09-17T07:46:09.319269Z","iopub.status.idle":"2026-09-17T07:46:21.94827Z","shell.execute_reply.started":"2026-09-17T07:46:09.319247Z","shell.execute_reply":"2026-09-17T07:46:21.947693Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.metrics import classification_report\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:44:41.849372Z","iopub.execute_input":"2026-09-17T07:44:41.850077Z","iopub.status.idle":"2026-09-17T07:44:41.975698Z","shell.execute_reply.started":"2026-09-17T07:44:41.850044Z","shell.execute_reply":"2026-09-17T07:44:41.975103Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"print(\n    classification_report(\n        y_true,\n        pred,\n        target_names=list(val_report.class_indices.keys())\n    )\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:46:53.840311Z","iopub.execute_input":"2026-09-17T07:46:53.840758Z","iopub.status.idle":"2026-09-17T07:46:53.861011Z","shell.execute_reply.started":"2026-09-17T07:46:53.840729Z","shell.execute_reply":"2026-09-17T07:46:53.86035Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay\nimport matplotlib.pyplot as plt\n\ncm = confusion_matrix(y_true, pred)\n\ndisp = ConfusionMatrixDisplay(\n    confusion_matrix=cm,\n    display_labels=list(val_report.class_indices.keys())\n)\n\ndisp.plot()\nplt.title(\"Confusion Matrix\")\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T07:51:16.27624Z","iopub.execute_input":"2026-09-17T07:51:16.27669Z","iopub.status.idle":"2026-09-17T07:51:16.419565Z","shell.execute_reply.started":"2026-09-17T07:51:16.27665Z","shell.execute_reply":"2026-09-17T07:51:16.418948Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Pretrained Models : \n- choosing lightweight and effective models.\n- EfficientNetBO\n- EfficientNetB0 provides a strong accuracy-to-parameter trade-off and supports transfer learning using pretrained ImageNet weights.","metadata":{}},{"cell_type":"markdown","source":"# Image Generator for Pretrained Model\n- path = \"/kaggle/working/dataset/PetImages\"","metadata":{}},{"cell_type":"code","source":"from tensorflow.keras.applications.efficientnet import preprocess_input","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-22T07:34:33.683877Z","iopub.execute_input":"2026-09-22T07:34:33.684233Z","iopub.status.idle":"2026-09-22T07:34:33.688582Z","shell.execute_reply.started":"2026-09-22T07:34:33.684208Z","shell.execute_reply":"2026-09-22T07:34:33.687958Z"}},"outputs":[],"execution_count":83},{"cell_type":"code","source":"i_d_g_p = ImageDataGenerator(\n    p