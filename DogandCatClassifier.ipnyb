and validation accuracy of 81.25%.\n- There was in total 5 epochs so in this model there will be total of 10 epochs.\n\n## Applying MaxPolling(2,2)\n-> after each Conv2d layer we just take the maxpixel value from 2*2 matrix in images for each layer.  \n-> Applying regularization layers.drop(0.2)","metadata":{"id":"npDm9FYlJDaz"}},{"cell_type":"code","source":"from tensorflow.keras.optimizers import Adam","metadata":{"id":"h6I30d-ILC6p","executionInfo":{"status":"ok","timestamp":1789582637087,"user_tz":-330,"elapsed":39,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T17:26:01.364089Z","iopub.execute_input":"2026-09-21T17:26:01.364315Z","iopub.status.idle":"2026-09-21T17:26:01.368074Z","shell.execute_reply.started":"2026-09-21T17:26:01.364295Z","shell.execute_reply":"2026-09-21T17:26:01.367254Z"}},"outputs":[],"execution_count":16},{"cell_type":"code","source":"def model2():\n  model = Sequential(\n      [\n        keras.Input(shape = (224,224,3)),\n\n        layers.Conv2D(filters=32,kernel_size=(3,3),activation='relu'),\n        layers.MaxPooling2D(pool_size=(2,2)),\n        layers.Dropout(0.25),\n\n        layers.Conv2D(filters=64,kernel_size=(3,3),activation='relu'),\n        layers.MaxPooling2D(pool_size=(2,2)),\n        layers.Dropout(0.25),\n\n        layers.Conv2D(filters=128,kernel_size=(3,3),activation='relu'),\n        layers.MaxPooling2D(pool_size=(2,2)),\n        layers.Dropout(0.25),\n\n        layers.Flatten(),\n        layers.Dense(units=64,activation='relu'),\n        layers.Dropout(0.5),\n        layers.Dense(units=1,activation='sigmoid')\n      ]\n  )\n  return model","metadata":{"id":"iud08lX6pXhX","executionInfo":{"status":"ok","timestamp":1789582638664,"user_tz":-330,"elapsed":46,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T17:26:01.368894Z","iopub.execute_input":"2026-09-21T17:26:01.369256Z","iopub.status.idle":"2026-09-21T17:26:01.380466Z","shell.execute_reply.started":"2026-09-21T17:26:01.369224Z","shell.execute_reply":"2026-09-21T17:26:01.379869Z"}},"outputs":[],"execution_count":17},{"cell_type":"code","source":"model_2 = model2()","metadata":{"id":"1oHEC-typXd4","executionInfo":{"status":"ok","timestamp":1789582641128,"user_tz":-330,"elapsed":103,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T17:26:01.381529Z","iopub.execute_input":"2026-09-21T17:26:01.382021Z","iopub.status.idle":"2026-09-21T17:26:01.438904Z","shell.execute_reply.started":"2026-09-21T17:26:01.381998Z","shell.execute_reply":"2026-09-21T17:26:01.438115Z"}},"outputs":[],"execution_count":18},{"cell_type":"code","source":"model_2.compile(optimizer='adam',\n              loss=\"binary_crossentropy\",\n              metrics=[\"accuracy\"])","metadata":{"id":"zP-sfbLDpXav","trusted":true,"execution":{"iopub.status.busy":"2026-09-21T17:26:01.43984Z","iopub.execute_input":"2026-09-21T17:26:01.440122Z","iopub.status.idle":"2026-09-21T17:26:01.447191Z","shell.execute_reply.started":"2026-09-21T17:26:01.440089Z","shell.execute_reply":"2026-09-21T17:26:01.446576Z"}},"outputs":[],"execution_count":19},{"cell_type":"code","source":"model_2.summary()","metadata":{"id":"3h_g_PBOpXXb","executionInfo":{"status":"ok","timestamp":1789393927176,"user_tz":-330,"elapsed":111,"user":{"displayName":"Karan Bhatt","userId":"17999398861783106427"}},"outputId":"a2ce0f9b-a601-4c6f-87c2-8edabab10394","trusted":true,"execution":{"iopub.status.busy":"2026-09-21T17:26:01.448057Z","iopub.execute_input":"2026-09-21T17:26:01.448347Z","iopub.status.idle":"2026-09-21T17:26:01.470069Z","shell.execute_reply.started":"2026-09-21T17:26:01.448315Z","shell.execute_reply":"2026-09-21T17:26:01.469497Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"\u001b[1mModel: \"sequential_1\"\u001b[0m\n","text/html":"<pre style=\"